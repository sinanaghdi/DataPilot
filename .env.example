# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# Note: DataPilot operates with a 100% deterministic, rule-based Persian NLP & analytics engine.
# No Gemini API key or external LLM API keys are required for operation.
